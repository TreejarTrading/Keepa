# --- Keepa API key ---
# The key is read, in priority order, from:
#   1. the KEEPA_API_KEY environment variable  (preferred)
#   2. this .env file
#   3. an "ENV DOCS" file in the project root
#
# Running in Claude Code (web/MCP)? Add KEEPA_API_KEY as an *environment
# variable* in your Claude Code environment settings. A GitHub repository /
# Actions secret is NOT enough — those are visible only to GitHub Actions
# workflows, never to the MCP server, so the key will appear "missing".
#
# Running locally? Copy this file to .env and paste the key below (no quotes,
# no trailing spaces — a stray newline or quote makes Keepa return 403).
KEEPA_API_KEY=your_keepa_api_key_here
APIFY_TOKEN=your_apify_token_here
# Опционально — подменить actor для Alibaba
# APIFY_ALIBABA_ACTOR=epctex/alibaba-scraper
# Для AE marketplace:
# BRIGHTDATA_TOKEN=your_brightdata_token_here
