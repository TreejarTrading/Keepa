# Keepa MCP server configuration
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# Required: your Keepa API key — https://keepa.com/#!api
KEEPA_API_KEY=

# Default Amazon marketplace (Keepa domain code by name):
# US UK DE FR JP CA IT ES IN MX
KEEPA_DOMAIN=US

# Days of price/sales-rank history used to compute stats (avg/min/max windows).
KEEPA_STATS_DAYS=90

# Default max number of products returned by a search.
KEEPA_SEARCH_LIMIT=50

# Where XLSX reports are written. Defaults to "<repo>/Продукты".
# On the target machine the repo lives at E:/KEEPA, so the default resolves to
# E:/KEEPA/Продукты automatically. Override only if you want a different path.
# KEEPA_OUTPUT_DIR=E:/KEEPA/Продукты
