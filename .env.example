# Keepa MCP server configuration
# Copy this file to ".env" and fill in your values. Never commit the real .env.
# Alternatively, keep the key in a file named "ENV DOCS" in the project root —
# the server reads it automatically (KEEPA_API_KEY=... line or a bare key).

# Required: your Keepa API key — https://keepa.com/#!api
KEEPA_API_KEY=

# Default Amazon marketplace:
# US UK DE FR IT ES (also JP CA IN MX BR)
KEEPA_DOMAIN=US

# Days of price/sales-rank history used to compute stats (avg/min/max windows).
KEEPA_STATS_DAYS=90

# Default max number of products returned by a search.
KEEPA_SEARCH_LIMIT=50

# Where XLSX reports are written. Defaults to "<repo>/Products".
# On the target machine the repo lives at /home/andrea/KEEPA, so the default
# resolves to /home/andrea/KEEPA/Products automatically.
# KEEPA_OUTPUT_DIR=/home/andrea/KEEPA/Products

# Saved searches for the 2-day auto mode (keepa-auto). Defaults to
# "<repo>/auto_searches.json".
# KEEPA_AUTO_SEARCH_FILE=/home/andrea/KEEPA/auto_searches.json
