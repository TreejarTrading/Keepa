# --- Database -------------------------------------------------------------
# Used by Prisma. With docker-compose the host is the "postgres" service.
DATABASE_URL="postgresql://keepa:keepa@localhost:5432/keepa?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-please-generate-a-long-random-secret"
# Session lifetime in hours.
AUTH_SESSION_HOURS="12"

# --- Initial administrator (created/updated by `npm run db:seed`) ----------
# This account gets the ADMIN role and can create logins for everyone else.
ADMIN_EMAIL="kadievdavid37@gmail.com"
ADMIN_PASSWORD="change-this-on-first-login"
ADMIN_NAME="Administrator"

# --- Keepa API ------------------------------------------------------------
# Personal Keepa API key (https://keepa.com/#!api). Required for live search.
KEEPA_API_KEY=""
# Default marketplace: US, GB, DE, FR, IT, ES, JP, CA, IN, MX, BR
KEEPA_DEFAULT_DOMAIN="US"
# Window (days) for price/rank statistics.
KEEPA_STATS_DAYS="90"
